{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuity.project.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "repository_id", "repository_root"],
  "properties": {
    "project_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$" },
    "repository_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$" },
    "repository_root": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$" },
    "enabled": { "type": "boolean" }
  }
}
